# tapeletter 입구 (docker-compose.edge.yml). 컨테이너·버킷 이름의 cassette는 내부 이름이다.
# 앞단 리버스 프록시(예: 미니PC의 myhandball Caddy)가 HTTPS를 끝내고 여기로 http로 넘긴다.
# 이 컨테이너만 앞단 프록시의 도커 네트워크에 들어간다. api·s3를 그 네트워크에 넣으면
# 서비스 이름(api, postgres 등)이 다른 프로젝트와 겹쳐 엉뚱한 컨테이너로 갈 수 있기 때문이다.
{
	admin off
	# 앞단 프록시가 넘긴 X-Forwarded-Proto·Host를 그대로 믿는다 (같은 도커 네트워크 안)
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	# 녹음 파일: S3 path-style presigned URL (https://<도메인>/<버킷>/<키>?X-Amz-...)
	# Host 헤더를 바꾸면 서명이 깨지므로 그대로 넘긴다 (reverse_proxy 기본 동작)
	@files path /{$S3_BUCKET:cassette}/*
	handle @files {
		reverse_proxy cassette-s3:9000 {
			# API의 trust proxy 1이 실제 사용자 IP를 보도록 앞단이 준 값을 그대로 넘긴다
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
		}
	}

	# AdMob app-ads.txt (스토어 등록의 개발자 웹사이트 = https://tapeletter.lab241.com, 전환 기간에는 옛 도메인도)
	# 게시자 ID는 AdMob 앱 ID(ca-app-pub-<게시자>~…)의 <게시자> 부분
	handle /app-ads.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond "google.com, pub-6280185901199691, DIRECT, f08c47fec0942fa0
" 200
	}

	# 소개 사이트 (정적, ops/edge/site → /srv/site). 정확히 이 경로만 여기서 끝나고 나머지는 전부 api로 간다
	@site path / /favicon.png /apple-touch-icon.png /site/*
	handle @site {
		root * /srv/site
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			Content-Security-Policy "default-src 'none'; style-src 'self' https://cdn.jsdelivr.net; font-src https://cdn.jsdelivr.net; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		}
		# 파일 이름에 해시가 없어 하루만 캐시한다. index는 매번 확인
		header /site/* Cache-Control "public, max-age=86400"
		header / Cache-Control "no-cache"
		file_server
	}

	# 나머지: API(/api/*), 링크 페이지(/t/*), /.well-known/*, /static/*, 정책 페이지(/privacy, /terms, /child-safety)
	handle {
		reverse_proxy cassette-api:3000 {
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
		}
	}
}
